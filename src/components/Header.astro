---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/docs/intro', label: 'Guide' },
  { href: '/apply', label: 'Apply' },
  { href: '/community', label: 'Community' },
  { href: '/knox-aftermath', label: 'Knox Aftermath - Project Zomboid Server' },
];

const discordUrl = 'https://discord.gg/Q5DmJDZFVR';
const currentPath = Astro.url.pathname;

const linkClass = (href: string) => `transition-colors hover:text-emerald-400 ${
  currentPath === href || currentPath.startsWith(href + '/')
    ? 'text-emerald-400'
    : 'text-gray-300'
}`;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0a0a0a]/95 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6" aria-label="Primary navigation">
    <a href="/" class="text-base font-bold tracking-widest text-white uppercase transition-colors hover:text-emerald-500 sm:text-lg">
      Fallen World
    </a>

    <ul class="hidden items-center gap-5 text-sm font-medium lg:flex">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class={linkClass(href)} aria-current={currentPath === href ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md bg-[#5865F2] px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-[#4752c4]"
        >
          Discord
        </a>
      </li>
    </ul>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-white/15 px-3 py-1.5 text-sm font-semibold text-gray-200 transition-colors hover:border-emerald-500/50 hover:text-white">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 w-72 rounded-md border border-white/10 bg-[#111] p-2 shadow-xl">
        <ul class="space-y-1 text-sm font-medium">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={`block rounded px-3 py-2 hover:bg-white/5 ${linkClass(href)}`}
                aria-current={currentPath === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a
              href={discordUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-md bg-[#5865F2] px-3 py-2 text-center font-semibold text-white transition-colors hover:bg-[#4752c4]"
            >
              Discord
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>
