---
const checks = [
  { id: 'steam', label: 'Steam copy of Fallout 4', detail: 'Fallen World supports the Steam release of Fallout 4.' },
  { id: 'ram', label: '16 GB or more system RAM', detail: 'The published minimum is 16 GB of system memory.' },
  { id: 'vram', label: '6 GB or more VRAM', detail: 'A GPU with at least 6 GB VRAM is required.' },
  { id: 'storage', label: '320 GB free on an SSD', detail: 'The install requires SSD storage and 320 GB free during setup.' },
  { id: 'overlays', label: 'Game overlays disabled', detail: 'Disable Steam, Discord, and other overlays before setup.' },
  { id: 'updates', label: 'Steam update behavior configured', detail: 'Set Fallout 4 to only update when the game is launched.' },
];
---

<div id="install-readiness" class="border-y border-gray-800">
  <div class="grid gap-8 py-7 lg:grid-cols-[1fr_280px]">
    <div>
      <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Install Readiness</div>
      <h2 class="mt-2 text-2xl font-bold text-white">Check before downloading</h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-400">
        Mark each requirement you have already handled. This checklist is stored only in your browser.
      </p>
    </div>
    <div class="lg:text-right">
      <div id="readiness-count" class="text-3xl font-extrabold text-white">0 / {checks.length}</div>
      <div id="readiness-state" class="mt-1 text-sm text-gray-500">Not ready yet</div>
    </div>
  </div>

  <div class="divide-y divide-gray-800 border-t border-gray-800">
    {checks.map((check) => (
      <label class="grid cursor-pointer gap-3 py-4 sm:grid-cols-[24px_220px_1fr] sm:items-start sm:gap-5">
        <input
          type="checkbox"
          class="readiness-check mt-1 h-4 w-4 accent-emerald-500"
          data-check-id={check.id}
        />
        <span class="font-semibold text-gray-100">{check.label}</span>
        <span class="text-sm leading-6 text-gray-500">{check.detail}</span>
      </label>
    ))}
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-gray-800 py-5">
    <button id="readiness-reset" type="button" class="text-sm font-semibold text-gray-500 hover:text-gray-300">
      Reset checklist
    </button>
    <a href="/docs/setup" class="rounded-md bg-[#0d9488] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#0f766e]">
      Open Installation Guide
    </a>
  </div>
</div>

<script>
  const storageKey = 'fallenworld-install-readiness-v1';
  const inputs = [...document.querySelectorAll('.readiness-check')];
  const count = document.getElementById('readiness-count');
  const state = document.getElementById('readiness-state');
  const reset = document.getElementById('readiness-reset');

  function readStored() {
    try {
      const value = localStorage.getItem(storageKey);
      return value ? JSON.parse(value) : {};
    } catch {
      return {};
    }
  }

  function saveStored() {
    const value = {};
    for (const input of inputs) {
      if (!(input instanceof HTMLInputElement)) continue;
      value[input.dataset.checkId || ''] = input.checked;
    }
    localStorage.setItem(storageKey, JSON.stringify(value));
  }

  function render() {
    const complete = inputs.filter((input) => input instanceof HTMLInputElement && input.checked).length;
    if (count) count.textContent = `${complete} / ${inputs.length}`;

    if (state) {
      if (complete === inputs.length) {
        state.textContent = 'Ready for the installation guide';
        state.classList.remove('text-gray-500');
        state.classList.add('text-emerald-400');
      } else {
        state.textContent = `${inputs.length - complete} requirement${inputs.length - complete === 1 ? '' : 's'} remaining`;
        state.classList.add('text-gray-500');
        state.classList.remove('text-emerald-400');
      }
    }
  }

  const stored = readStored();
  for (const input of inputs) {
    if (!(input instanceof HTMLInputElement)) continue;
    input.checked = Boolean(stored[input.dataset.checkId || '']);
    input.addEventListener('change', () => {
      saveStored();
      render();
    });
  }

  reset?.addEventListener('click', () => {
    for (const input of inputs) {
      if (input instanceof HTMLInputElement) input.checked = false;
    }
    localStorage.removeItem(storageKey);
    render();
  });

  render();
</script>
