---
import Layout from '../layouts/Layout.astro';
import galleryData from '../data/gallery.json';
import homeData from '../data/fallenworld-home.json';
---

<Layout
  title="Fallen World | Hardcore Survival for Fallout 4"
  description="Fallen World is a hardcore Fallout 4 survival modlist with lethal combat, deep survival systems, expanded content, and automated installation."
>
  <section class="hero-shell">
    <div id="hero-bg" class="hero-bg">
      <iframe
        id="hero-player"
        class="hero-video"
        data-src="https://www.youtube-nocookie.com/embed/GEV6T70Wgzk?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1&start=8"
        title="Fallen World background video"
        frameborder="0"
        allow="autoplay"
        aria-hidden="true"
      ></iframe>
      <img id="bg-img-a" class="hero-img hero-img-active" src="/img/HomeImage.webp" alt="" aria-hidden="true" />
      <img id="bg-img-b" class="hero-img" src="" alt="" aria-hidden="true" />
      <div class="hero-scrim"></div>
    </div>

    <button id="sound-btn" aria-label="Enable background video sound">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
      </svg>
      Enable Sound
    </button>

    <div class="hero-copy">
      <img src="/img/radiation.svg" alt="" aria-hidden="true" class="hero-mark" />
      <h1>Fallen World</h1>
      <p>The #1 hardcore survival experience for Fallout 4</p>
      <div class="hero-actions">
        <a href="https://www.wabbajack.org/" target="_blank" rel="noopener noreferrer" class="primary-action">Install with Wabbajack</a>
        <a href="/docs/intro" class="secondary-action">Guide</a>
      </div>
      <div class="hero-stats">
        <span><strong>100K+</strong> Downloads</span>
        <span><strong>600+</strong> Mods</span>
      </div>
    </div>
  </section>

  <section class="border-y border-gray-800 bg-[#0d0d0d] px-6 py-5">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px overflow-hidden border border-gray-800 bg-gray-800 sm:grid-cols-4">
      <a href="/docs/requirements" class="bg-[#0d0d0d] px-5 py-4 text-sm font-semibold text-gray-200 hover:text-emerald-400">Requirements</a>
      <a href="/docs/setup" class="bg-[#0d0d0d] px-5 py-4 text-sm font-semibold text-gray-200 hover:text-emerald-400">Install</a>
      <a href="/features" class="bg-[#0d0d0d] px-5 py-4 text-sm font-semibold text-gray-200 hover:text-emerald-400">Features</a>
      <a href="/roadmap" class="bg-[#0d0d0d] px-5 py-4 text-sm font-semibold text-gray-200 hover:text-emerald-400">Roadmap</a>
    </div>
  </section>

  <section class="bg-[#0a0a0a] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Gameplay</div>
          <h2 class="mt-2 text-2xl font-bold text-white">Core Systems</h2>
        </div>
        <a href="/features" class="text-sm font-semibold text-emerald-400 hover:text-emerald-300">All features</a>
      </div>

      <div class="grid gap-px overflow-hidden border border-gray-800 bg-gray-800 sm:grid-cols-2 lg:grid-cols-3">
        {homeData.coreSystems.map((system) => (
          <a href={system.href} class="bg-[#0d0d0d] px-5 py-5 font-semibold text-gray-100 hover:text-emerald-400">
            {system.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-gray-800 bg-[#0a0a0a] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Gallery</div>
          <h2 class="mt-2 text-2xl font-bold text-white">Fallen World In Game</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {galleryData.images.map((src, index) => (
          <div class="aspect-video overflow-hidden rounded-md border border-gray-800 bg-[#111]">
            <img src={src} alt={`Fallen World gameplay screenshot ${index + 1}`} loading="lazy" class="h-full w-full object-cover" />
          </div>
        ))}
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {galleryData.videos.map((video) => (
          <div class="video-wrap">
            <button
              type="button"
              class="video-facade"
              data-video-id={video.id}
              data-video-title={video.title}
              aria-label={`Play ${video.title}`}
            >
              <img src={video.thumbnail} alt="" loading="lazy" aria-hidden="true" />
              <span class="video-play">Play video</span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <footer class="border-t border-gray-800 bg-[#0a0a0a] px-6 py-8 text-center text-xs text-gray-500">
    Fallen World is an unofficial fan project. Not affiliated with Bethesda Game Studios.
    <span class="mx-2">·</span>
    <a href="https://discord.gg/Q5DmJDZFVR" target="_blank" rel="noopener noreferrer" class="text-teal-400">Discord</a>
    <span class="mx-2">·</span>
    <a href="https://loadorderlibrary.com/lists/fallout-anomaly-0-5" target="_blank" rel="noopener noreferrer" class="text-teal-400">Modlist</a>
    <span class="mx-2">·</span>
    <a href="/privacy" class="text-teal-400">Privacy</a>
  </footer>
</Layout>

<script define:vars={{ images: galleryData.images }}>
  const FADE_MS = 1800;
  const IMAGE_HOLD_MS = 7000;
  const HERO_VIDEO_START = 8;

  const videoEl = document.getElementById('hero-player');
  const imgA = document.getElementById('bg-img-a');
  const imgB = document.getElementById('bg-img-b');
  const soundBtn = document.getElementById('sound-btn');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active = imgA;
  let inactive = imgB;
  let ytPlayer = null;

  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  function crossfadeTo(src) {
    if (!active || !inactive) return;
    inactive.src = src;
    inactive.classList.add('hero-img-active');
    active.classList.remove('hero-img-active');
    const previous = active;
    active = inactive;
    inactive = previous;
  }

  async function runSlideshow() {
    if (reduceMotion || !videoEl || !active) return;
    videoEl.classList.remove('hero-video-active');
    await sleep(FADE_MS);

    for (const src of images) {
      crossfadeTo(src);
      await sleep(IMAGE_HOLD_MS);
    }

    if (ytPlayer) ytPlayer.seekTo(HERO_VIDEO_START, true);
    active.classList.remove('hero-img-active');
    videoEl.classList.add('hero-video-active');
    ytPlayer?.playVideo();
  }

  function enableSound() {
    if (!ytPlayer || !soundBtn) return;
    ytPlayer.unMute();
    ytPlayer.setVolume(18);
    soundBtn.style.display = 'none';
  }

  if (reduceMotion) {
    if (videoEl) videoEl.style.display = 'none';
    if (soundBtn) soundBtn.style.display = 'none';
  } else if (videoEl) {
    videoEl.src = videoEl.dataset.src || '';
    soundBtn?.addEventListener('click', enableSound);

    window.onYouTubeIframeAPIReady = function () {
      ytPlayer = new window.YT.Player('hero-player', {
        events: {
          onReady: function(event) {
            event.target.seekTo(HERO_VIDEO_START, true);
            event.target.playVideo();
            setTimeout(() => videoEl.classList.add('hero-video-active'), 450);
          },
          onStateChange: function(event) {
            if (event.data === 0) runSlideshow();
          },
        },
      });
    };

    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
  }

  document.querySelectorAll('.video-facade').forEach((button) => {
    button.addEventListener('click', () => {
      const videoId = button.dataset.videoId;
      if (!videoId) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = button.dataset.videoTitle || 'Fallen World video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      button.replaceWith(iframe);
    });
  });
</script>

<style>
  .hero-shell {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0a0a0a;
  }

  .hero-video,
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.8s ease;
  }

  .hero-video {
    top: 50%;
    left: 50%;
    width: 177.78vh;
    height: 100vh;
    min-width: 100%;
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-video-active,
  .hero-img-active {
    opacity: 1;
  }

  .hero-img {
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(10, 10, 10, 0.5);
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    display: flex;
    max-width: 720px;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    text-align: center;
  }

  .hero-mark {
    width: 96px;
    filter: drop-shadow(0 0 12px rgba(13,148,136,0.4));
    animation: spin 8s linear infinite;
  }

  .hero-copy h1 {
    margin: 1rem 0 0.35rem;
    color: #f5f5f5;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-copy p {
    margin: 0;
    color: #9ca3af;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .primary-action,
  .secondary-action {
    border-radius: 6px;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-action {
    background: #0d9488;
    color: white;
    text-transform: uppercase;
  }

  .secondary-action {
    border: 1px solid #4b5563;
    color: #e5e7eb;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    color: #9ca3af;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-stats strong {
    color: #14b8a6;
    font-size: 1.15rem;
    margin-right: 0.3rem;
  }

  #sound-btn {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    background: rgba(0,0,0,0.65);
    color: #f3f4f6;
    padding: 0.5rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .video-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid #374151;
    background: #111;
  }

  .video-facade {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #111;
  }

  .video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 999px;
    background: rgba(0,0,0,0.78);
    color: white;
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
