---
import Layout from '../layouts/Layout.astro';
import galleryData from '../data/gallery.json';
---

<Layout
  title="Fallen World | Hardcore Survival for Fallout 4"
  description="Fallen World is a hardcore Fallout 4 survival modlist with lethal combat, deep survival systems, expanded content, and automated installation."
>
  <section style="position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
    <div id="hero-bg" class="hero-bg">
      <iframe
        id="hero-player"
        class="hero-video"
        data-src="https://www.youtube-nocookie.com/embed/GEV6T70Wgzk?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1"
        title="Fallen World background video"
        frameborder="0"
        allow="autoplay"
        aria-hidden="true"
      ></iframe>
      <img id="bg-img-a" class="hero-img" src="" alt="" aria-hidden="true" />
      <img id="bg-img-b" class="hero-img" src="" alt="" aria-hidden="true" />
      <div class="hero-scrim"></div>
    </div>

    <button id="sound-btn" aria-label="Enable background video sound">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
      </svg>
      Enable Sound
    </button>

    <div style="position: relative; z-index: 2; text-align: center; max-width: 700px; padding: 2rem; display: flex; flex-direction: column; align-items: center;">
      <div style="margin-bottom: 1rem;">
        <img
          src="/img/radiation.svg"
          alt=""
          aria-hidden="true"
          style="max-width: 120px; width: 100%; height: auto; filter: drop-shadow(0 0 12px rgba(13,148,136,0.4)); animation: spin 8s linear infinite;"
        />
      </div>
      <h1 style="margin: 0 0 0.5rem; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; color: #f5f5f5; letter-spacing: 0.15em; text-transform: uppercase; text-shadow: 0 0 30px rgba(13,148,136,0.3); line-height: 1.1;">
        Fallen World
      </h1>
      <p style="margin: 0 0 1.5rem; font-size: 1.15rem; color: #9ca3af;">
        The #1 hardcore survival experience for Fallout 4
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
        <a
          href="https://www.wabbajack.org/"
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-block; padding: 0.75rem 1.75rem; background: #0d9488; color: #fff; font-weight: 700; border-radius: 6px; text-decoration: none; letter-spacing: 0.05em; text-transform: uppercase; font-size: 0.9rem;"
        >
          Install with Wabbajack
        </a>
        <a
          href="/docs/intro"
          style="display: inline-block; padding: 0.75rem 1.75rem; border: 2px solid rgba(255,255,255,0.2); color: #e5e7eb; font-weight: 600; border-radius: 6px; text-decoration: none; font-size: 0.9rem;"
        >
          Read the Guide
        </a>
      </div>

      <div style="display: flex; justify-content: center; gap: 2.5rem; margin-top: 2.5rem; flex-wrap: wrap;">
        {[
          { value: '100K+', label: 'Downloads' },
          { value: '600+', label: 'Mods Included' },
          { value: 'Wabbajack', label: 'One-Click Install' },
        ].map(({ value, label }) => (
          <div style="text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 800; color: #0d9488;">{value}</div>
            <div style="font-size: 0.8rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.08em;">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background: #0a0a0a; padding: 5rem 1.5rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #0d9488; margin-bottom: 0.5rem;">Gallery</div>
        <h2 style="font-size: 2rem; font-weight: 800; color: #f5f5f5; text-transform: uppercase; letter-spacing: 0.1em;">The Wasteland Awaits</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 1rem; margin-bottom: 3rem;">
        {galleryData.images.map((src, index) => (
          <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: 6px; border: 1px solid #374151;">
            <img
              src={src}
              alt={`Fallen World gameplay screenshot ${index + 1}`}
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </div>
        ))}
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 1.5rem;">
        {galleryData.videos.map((video) => (
          <div class="video-wrap">
            <button
              type="button"
              class="video-facade"
              data-video-id={video.id}
              data-video-title={video.title}
              aria-label={`Play ${video.title}`}
            >
              <img src={video.thumbnail} alt="" loading="lazy" aria-hidden="true" />
              <span class="video-play">Play video</span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <footer style="background: #0a0a0a; border-top: 1px solid #1f2937; padding: 2rem 1.5rem; text-align: center;">
    <p style="font-size: 0.8rem; color: #9ca3af; margin: 0;">
      Fallen World is an unofficial fan project. Not affiliated with Bethesda Game Studios.
      <span style="margin: 0 0.5rem;">·</span>
      <a href="https://discord.gg/Q5DmJDZFVR" target="_blank" rel="noopener noreferrer" style="color: #2dd4bf; text-decoration: none;">Discord</a>
      <span style="margin: 0 0.5rem;">·</span>
      <a href="https://loadorderlibrary.com/lists/fallout-anomaly-0-5" target="_blank" rel="noopener noreferrer" style="color: #2dd4bf; text-decoration: none;">Modlist</a>
      <span style="margin: 0 0.5rem;">·</span>
      <a href="/privacy" style="color: #2dd4bf; text-decoration: none;">Privacy</a>
    </p>
  </footer>
</Layout>

<script define:vars={{ images: galleryData.images }}>
  const FADE_MS = 2500;
  const IMAGE_HOLD_MS = 7000;

  const heroBg = document.getElementById('hero-bg');
  const videoEl = document.getElementById('hero-player');
  const imgA = document.getElementById('bg-img-a');
  const imgB = document.getElementById('bg-img-b');
  const soundBtn = document.getElementById('sound-btn');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active = imgA;
  let inactive = imgB;
  let ytPlayer = null;

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function crossfadeTo(src) {
    if (!active || !inactive) return;
    inactive.src = src;
    inactive.style.opacity = '1';
    active.style.opacity = '0';
    const tmp = active;
    active = inactive;
    inactive = tmp;
  }

  async function runSlideshow() {
    if (reduceMotion || !videoEl || !active) return;
    videoEl.style.opacity = '0';
    await sleep(FADE_MS);

    for (let i = 0; i < images.length; i++) {
      crossfadeTo(images[i]);
      await sleep(IMAGE_HOLD_MS);
    }

    active.style.opacity = '0';
    videoEl.style.opacity = '1';
    await sleep(FADE_MS);

    if (ytPlayer) {
      ytPlayer.seekTo(0);
      ytPlayer.playVideo();
    }
  }

  function enableSound() {
    if (!ytPlayer || !soundBtn) return;
    ytPlayer.unMute();
    ytPlayer.setVolume(18);
    soundBtn.style.opacity = '0';
    setTimeout(() => { soundBtn.style.display = 'none'; }, 600);
  }

  if (reduceMotion) {
    heroBg?.classList.add('reduced-motion');
    if (soundBtn) soundBtn.style.display = 'none';
  } else if (videoEl) {
    videoEl.src = videoEl.dataset.src || '';
    soundBtn?.addEventListener('click', enableSound);

    window.onYouTubeIframeAPIReady = function () {
      ytPlayer = new window.YT.Player('hero-player', {
        events: {
          onReady: function() {},
          onStateChange: function(event) {
            if (event.data === 0) runSlideshow();
          },
        },
      });
    };

    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
  }

  document.querySelectorAll('.video-facade').forEach((button) => {
    button.addEventListener('click', () => {
      const videoId = button.dataset.videoId;
      if (!videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = button.dataset.videoTitle || 'Fallen World video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      button.replaceWith(iframe);
    });
  });
</script>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0a0a0a;
  }

  .hero-bg.reduced-motion {
    background: #0a0a0a url('/img/HomeImage.webp') center / cover no-repeat;
  }

  .hero-bg.reduced-motion .hero-video,
  .hero-bg.reduced-motion .hero-img {
    display: none;
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.78vh;
    height: 100vh;
    min-width: 100%;
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 2.5s ease-in-out;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 2.5s ease-in-out;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.5);
    z-index: 2;
  }

  #sound-btn {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0,0,0,0.65);
    border: 1px solid rgba(255,255,255,0.25);
    color: #f3f4f6;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.5rem 0.8rem;
    border-radius: 99px;
    cursor: pointer;
    transition: opacity 0.6s ease, background 0.2s;
    backdrop-filter: blur(4px);
  }

  #sound-btn:hover {
    background: rgba(13,148,136,0.5);
    border-color: #2dd4bf;
  }

  .video-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid #374151;
    background: #111;
  }

  .video-facade {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #111;
  }

  .video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.82;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .video-facade:hover img,
  .video-facade:focus-visible img {
    opacity: 1;
    transform: scale(1.02);
  }

  .video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
