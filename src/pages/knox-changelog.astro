---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const [entry] = await getCollection('knoxChangelog');
const { Content } = await render(entry);
---

<Layout
  title="Knox Aftermath Changelog"
  description="Server and website changelog for Fallen World: Knox Aftermath."
>
  <main class="knox-changelog w-full px-5 py-14 sm:px-8 sm:py-20 lg:px-12 xl:px-16 2xl:px-20">
    <header class="changelog-hero">
      <div class="changelog-kicker">Knox Aftermath</div>
      <h1>Changelog</h1>
      <p>
        Browse updates by date. Open a date to see every update published that day, then expand an update or category for the full details.
      </p>
    </header>

    <div id="knox-changelog-content" class="changelog-content prose-doc">
      <Content />
    </div>
  </main>

  <script>
    const enhanceChangelog = () => {
      const root = document.querySelector('#knox-changelog-content');
      if (!(root instanceof HTMLElement) || root.dataset.enhanced === 'true') return;
      root.dataset.enhanced = 'true';

      root.querySelector(':scope > h1')?.remove();

      const parseDateTitle = (text) => {
        const match = text.trim().match(/^(\d{4}-\d{2}-\d{2})\s*-\s*(.+)$/);
        if (!match) return null;
        return { date: match[1], title: match[2] };
      };

      const isDatedElement = (element) => {
        if (element instanceof HTMLHeadingElement && element.tagName === 'H2') {
          return parseDateTitle(element.textContent ?? '') !== null;
        }
        if (element instanceof HTMLDetailsElement) {
          const summary = element.querySelector(':scope > summary');
          return parseDateTitle(summary?.textContent ?? '') !== null;
        }
        return false;
      };

      const originals = Array.from(root.children);
      const releases = [];
      const leading = [];
      let foundRelease = false;

      for (let index = 0; index < originals.length; index += 1) {
        const element = originals[index];

        if (element instanceof HTMLHeadingElement && element.tagName === 'H2') {
          const parsed = parseDateTitle(element.textContent ?? '');
          if (parsed) {
            foundRelease = true;
            const nodes = [];
            let cursor = index + 1;
            while (cursor < originals.length && !isDatedElement(originals[cursor])) {
              nodes.push(originals[cursor]);
              cursor += 1;
            }
            releases.push({ ...parsed, nodes });
            index = cursor - 1;
            continue;
          }
        }

        if (element instanceof HTMLDetailsElement) {
          const summary = element.querySelector(':scope > summary');
          const parsed = parseDateTitle(summary?.textContent ?? '');
          if (summary && parsed) {
            foundRelease = true;
            const nodes = Array.from(element.childNodes).filter((node) => node !== summary);
            releases.push({ ...parsed, nodes });
            continue;
          }
        }

        if (!foundRelease) leading.push(element);
      }

      const grouped = new Map();
      for (const release of releases) {
        const entries = grouped.get(release.date) ?? [];
        entries.push(release);
        grouped.set(release.date, entries);
      }

      root.replaceChildren(...leading);

      let dateIndex = 0;
      for (const [date, entries] of grouped) {
        const dateSection = document.createElement('details');
        dateSection.className = 'changelog-date';
        if (dateIndex === 0) {
          dateSection.open = true;
          dateSection.classList.add('changelog-date--latest');
        }

        const dateSummary = document.createElement('summary');

        const dateWrap = document.createElement('span');
        dateWrap.className = 'changelog-date__date';
        const time = document.createElement('time');
        time.dateTime = date;
        time.textContent = date;
        dateWrap.append(time);

        const count = document.createElement('span');
        count.className = 'changelog-date__count';
        count.textContent = `${entries.length} ${entries.length === 1 ? 'update' : 'updates'}`;

        const hint = document.createElement('span');
        hint.className = 'changelog-date__hint';
        hint.textContent = 'View date';

        dateSummary.append(dateWrap, count, hint);

        const dateBody = document.createElement('div');
        dateBody.className = 'changelog-date__body';

        entries.forEach((release, releaseIndex) => {
          const update = document.createElement('details');
          update.className = 'changelog-update';
          if (dateIndex === 0 && releaseIndex === 0) update.open = true;

          const updateSummary = document.createElement('summary');
          const updateTitle = document.createElement('span');
          updateTitle.className = 'changelog-update__title';
          updateTitle.textContent = release.title;

          const updateHint = document.createElement('span');
          updateHint.className = 'changelog-update__hint';
          updateHint.textContent = 'Details';

          updateSummary.append(updateTitle, updateHint);

          const updateContent = document.createElement('div');
          updateContent.className = 'changelog-update__content';
          updateContent.append(...release.nodes);

          update.append(updateSummary, updateContent);
          dateBody.append(update);
        });

        dateSection.append(dateSummary, dateBody);
        root.append(dateSection);
        dateIndex += 1;
      }
    };

    enhanceChangelog();
    document.addEventListener('astro:page-load', enhanceChangelog);
  </script>

  <style is:global>
    .knox-changelog {
      --knox-line: rgba(71, 85, 105, 0.58);
      --knox-panel: rgba(15, 15, 15, 0.96);
      --knox-panel-soft: rgba(22, 22, 22, 0.86);
      --knox-panel-deep: rgba(10, 10, 10, 0.7);
      --knox-accent: #2dd4bf;
    }

    .knox-changelog .changelog-hero {
      width: 100%;
      max-width: 72rem;
      margin-bottom: 2.5rem;
    }

    .knox-changelog .changelog-kicker {
      color: var(--knox-accent);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 0.65rem;
    }

    .knox-changelog .changelog-hero h1 {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 1;
      letter-spacing: -0.035em;
      font-weight: 850;
    }

    .knox-changelog .changelog-hero p {
      max-width: 58rem;
      margin: 1rem 0 0;
      color: #aeb7c3;
      line-height: 1.7;
      font-size: 1rem;
    }

    .knox-changelog .changelog-content.prose-doc {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    .knox-changelog .changelog-date {
      width: 100%;
      margin: 0 0 1rem;
      padding: 0;
      overflow: clip;
      border: 1px solid var(--knox-line);
      border-radius: 12px;
      background:
        linear-gradient(90deg, rgba(45, 212, 191, 0.045), transparent 24%),
        var(--knox-panel);
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
    }

    .knox-changelog .changelog-date--latest {
      border-color: rgba(45, 212, 191, 0.44);
    }

    .knox-changelog .changelog-date > summary {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 1rem;
      align-items: center;
      min-height: 4.5rem;
      padding: 0.95rem 1.15rem;
      margin: 0;
      cursor: pointer;
      list-style: none;
      color: #f8fafc;
      background: rgba(255, 255, 255, 0.018);
      transition: background 160ms ease;
    }

    .knox-changelog .changelog-date > summary::-webkit-details-marker,
    .knox-changelog .changelog-update > summary::-webkit-details-marker,
    .knox-changelog .changelog-update__content details > summary::-webkit-details-marker {
      display: none;
    }

    .knox-changelog .changelog-date > summary:hover {
      background: rgba(45, 212, 191, 0.055);
    }

    .knox-changelog .changelog-date[open] > summary {
      border-bottom: 1px solid rgba(71, 85, 105, 0.46);
      background: rgba(45, 212, 191, 0.045);
    }

    .knox-changelog .changelog-date__date {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      border: 1px solid rgba(45, 212, 191, 0.34);
      border-radius: 999px;
      background: rgba(13, 148, 136, 0.1);
      padding: 0.38rem 0.72rem;
      color: #8ff5e7;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.045em;
      font-variant-numeric: tabular-nums;
    }

    .knox-changelog .changelog-date__count {
      color: #cbd5e1;
      font-size: 0.88rem;
      font-weight: 700;
    }

    .knox-changelog .changelog-date__hint,
    .knox-changelog .changelog-update__hint {
      color: #8793a2;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .knox-changelog .changelog-date__hint::after,
    .knox-changelog .changelog-update__hint::after {
      content: '›';
      display: inline-block;
      margin-left: 0.45rem;
      color: var(--knox-accent);
      font-size: 1.2rem;
      line-height: 1;
      transform: rotate(90deg);
      transition: transform 160ms ease;
    }

    .knox-changelog .changelog-date[open] > summary .changelog-date__hint::after,
    .knox-changelog .changelog-update[open] > summary .changelog-update__hint::after {
      transform: rotate(-90deg);
    }

    .knox-changelog .changelog-date__body {
      width: 100%;
      padding: 1rem;
    }

    .knox-changelog .changelog-update {
      width: 100%;
      margin: 0 0 0.8rem;
      overflow: hidden;
      border: 1px solid rgba(71, 85, 105, 0.56);
      border-radius: 9px;
      background: var(--knox-panel-soft);
    }

    .knox-changelog .changelog-update:last-child {
      margin-bottom: 0;
    }

    .knox-changelog .changelog-update > summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: center;
      min-height: 3.75rem;
      padding: 0.85rem 1rem;
      margin: 0;
      cursor: pointer;
      list-style: none;
      background: rgba(255, 255, 255, 0.018);
    }

    .knox-changelog .changelog-update > summary:hover {
      background: rgba(255, 255, 255, 0.032);
    }

    .knox-changelog .changelog-update[open] > summary {
      border-bottom: 1px solid rgba(71, 85, 105, 0.44);
    }

    .knox-changelog .changelog-update__title {
      color: #eef2f7;
      font-size: 0.98rem;
      font-weight: 750;
      letter-spacing: -0.01em;
    }

    .knox-changelog .changelog-update__content {
      width: 100%;
      padding: 1rem 1.15rem 1.2rem;
      color: #c2cad3;
      background: var(--knox-panel-deep);
    }

    .knox-changelog .changelog-update__content > :first-child {
      margin-top: 0;
    }

    .knox-changelog .changelog-update__content > :last-child {
      margin-bottom: 0;
    }

    .knox-changelog .changelog-update__content > p {
      max-width: 110ch;
    }

    .knox-changelog .changelog-update__content > details {
      width: 100%;
      margin: 0.7rem 0;
      overflow: hidden;
      border: 1px solid rgba(71, 85, 105, 0.48);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.018);
    }

    .knox-changelog .changelog-update__content > details > summary {
      min-height: 3.2rem;
      display: flex;
      align-items: center;
      padding: 0.75rem 0.9rem;
      margin: 0;
      color: #e8edf3;
      font-size: 0.9rem;
      font-weight: 700;
      list-style: none;
      cursor: pointer;
    }

    .knox-changelog .changelog-update__content > details > summary::before {
      content: '+';
      display: inline-grid;
      place-items: center;
      width: 1.35rem;
      height: 1.35rem;
      margin-right: 0.65rem;
      border-radius: 5px;
      background: rgba(45, 212, 191, 0.09);
      color: var(--knox-accent);
      font-size: 1rem;
      font-weight: 500;
    }

    .knox-changelog .changelog-update__content > details[open] > summary::before {
      content: '-';
    }

    .knox-changelog .changelog-update__content > details[open] > summary {
      color: #8ff5e7;
      border-bottom: 1px solid rgba(71, 85, 105, 0.4);
    }

    .knox-changelog .changelog-update__content > details > :not(summary) {
      margin-left: 1rem;
      margin-right: 1rem;
    }

    .knox-changelog .changelog-update__content ul,
    .knox-changelog .changelog-update__content ol {
      padding-left: 1.35rem;
    }

    .knox-changelog .changelog-update__content li {
      padding: 0.3rem 0;
    }

    .knox-changelog .changelog-update__content li > p {
      margin: 0;
    }

    .knox-changelog .changelog-update__content img {
      width: 72px;
      max-height: 72px;
      object-fit: cover;
      display: inline-block;
      vertical-align: middle;
      margin: 0 0.75rem 0.25rem 0;
      border: 1px solid rgba(71, 85, 105, 0.55);
      border-radius: 8px;
      background: #0b0b0b;
    }

    @media (min-width: 1280px) {
      .knox-changelog .changelog-date__body {
        padding: 1.15rem 1.25rem 1.3rem;
      }

      .knox-changelog .changelog-update__content {
        padding: 1.2rem 1.4rem 1.4rem;
      }
    }

    @media (max-width: 720px) {
      .knox-changelog {
        padding-left: 1rem;
        padding-right: 1rem;
      }

      .knox-changelog .changelog-date > summary {
        grid-template-columns: 1fr auto;
        gap: 0.45rem 0.8rem;
        padding: 0.85rem 0.9rem;
      }

      .knox-changelog .changelog-date__date,
      .knox-changelog .changelog-date__count {
        grid-column: 1;
      }

      .knox-changelog .changelog-date__hint {
        grid-column: 2;
        grid-row: 1 / span 2;
        align-self: center;
        font-size: 0;
      }

      .knox-changelog .changelog-date__hint::after {
        font-size: 1.35rem;
      }

      .knox-changelog .changelog-date__body {
        padding: 0.75rem;
      }

      .knox-changelog .changelog-update__content {
        padding: 0.85rem;
      }

      .knox-changelog .changelog-update__hint {
        font-size: 0;
      }

      .knox-changelog .changelog-update__hint::after {
        font-size: 1.25rem;
      }
    }
  </style>
</Layout>
