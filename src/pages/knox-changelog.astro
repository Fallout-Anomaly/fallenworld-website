---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const [entry] = await getCollection('knoxChangelog');
const { Content } = await render(entry);
---

<Layout
  title="Knox Aftermath Changelog"
  description="Server and website changelog for Fallen World: Knox Aftermath."
>
  <main class="knox-changelog mx-auto w-full max-w-[88rem] px-5 py-14 sm:px-8 sm:py-20 lg:px-12">
    <header class="changelog-hero">
      <div class="changelog-kicker">Knox Aftermath</div>
      <h1>Changelog</h1>
      <p>
        Browse updates by date. Open a release to see its changes, then expand a category for the full details and linked Workshop items.
      </p>
    </header>

    <div id="knox-changelog-content" class="changelog-content prose-doc">
      <Content />
    </div>
  </main>

  <script>
    const enhanceChangelog = () => {
      const root = document.querySelector('#knox-changelog-content');
      if (!(root instanceof HTMLElement) || root.dataset.enhanced === 'true') return;
      root.dataset.enhanced = 'true';

      root.querySelector(':scope > h1')?.remove();

      const isDateText = (text) => /^\d{4}-\d{2}-\d{2}\s*[-–—]/.test(text.trim());

      const decorateDateSummary = (summary) => {
        const raw = summary.textContent?.trim() ?? '';
        const match = raw.match(/^(\d{4}-\d{2}-\d{2})\s*[-–—]\s*(.+)$/);
        if (!match) return;

        const [, date, title] = match;
        summary.textContent = '';

        const dateWrap = document.createElement('span');
        dateWrap.className = 'changelog-date__date';

        const time = document.createElement('time');
        time.dateTime = date;
        time.textContent = date;
        dateWrap.append(time);

        const titleEl = document.createElement('span');
        titleEl.className = 'changelog-date__title';
        titleEl.textContent = title;

        const hint = document.createElement('span');
        hint.className = 'changelog-date__hint';
        hint.textContent = 'View update';

        summary.append(dateWrap, titleEl, hint);
      };

      const children = Array.from(root.children);
      let activeBody = null;
      let firstDateSection = null;

      for (const child of children) {
        if (child instanceof HTMLHeadingElement && child.tagName === 'H2' && isDateText(child.textContent ?? '')) {
          const section = document.createElement('details');
          section.className = 'changelog-date';

          const summary = document.createElement('summary');
          summary.textContent = child.textContent ?? '';
          decorateDateSummary(summary);

          const body = document.createElement('div');
          body.className = 'changelog-date__body';

          section.append(summary, body);
          root.insertBefore(section, child);
          child.remove();

          activeBody = body;
          firstDateSection ??= section;
          continue;
        }

        if (child instanceof HTMLDetailsElement) {
          const summary = child.querySelector(':scope > summary');
          const summaryText = summary?.textContent?.trim() ?? '';

          if (summary && isDateText(summaryText)) {
            child.classList.add('changelog-date');
            decorateDateSummary(summary);
            activeBody = null;
            firstDateSection ??= child;
            continue;
          }
        }

        if (activeBody) activeBody.append(child);
      }

      if (firstDateSection instanceof HTMLDetailsElement) {
        firstDateSection.open = true;
        firstDateSection.classList.add('changelog-date--latest');
      }

      for (const section of root.querySelectorAll(':scope > details.changelog-date')) {
        const body = section.querySelector(':scope > .changelog-date__body');
        if (!body) {
          const wrapper = document.createElement('div');
          wrapper.className = 'changelog-date__body';
          const summary = section.querySelector(':scope > summary');
          let node = summary?.nextSibling ?? null;
          while (node) {
            const next = node.nextSibling;
            wrapper.append(node);
            node = next;
          }
          section.append(wrapper);
        }
      }
    };

    enhanceChangelog();
    document.addEventListener('astro:page-load', enhanceChangelog);
  </script>

  <style is:global>
    .knox-changelog {
      --knox-line: rgba(71, 85, 105, 0.55);
      --knox-panel: rgba(15, 15, 15, 0.94);
      --knox-panel-soft: rgba(22, 22, 22, 0.8);
      --knox-accent: #2dd4bf;
    }

    .knox-changelog .changelog-hero {
      max-width: 56rem;
      margin-bottom: 2.5rem;
    }

    .knox-changelog .changelog-kicker {
      color: var(--knox-accent);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 0.65rem;
    }

    .knox-changelog .changelog-hero h1 {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 1;
      letter-spacing: -0.035em;
      font-weight: 850;
    }

    .knox-changelog .changelog-hero p {
      max-width: 46rem;
      margin: 1rem 0 0;
      color: #aeb7c3;
      line-height: 1.7;
      font-size: 1rem;
    }

    .knox-changelog .changelog-content.prose-doc {
      max-width: none;
      width: 100%;
    }

    .knox-changelog .changelog-content > p {
      max-width: 72ch;
    }

    .knox-changelog .changelog-date {
      margin: 0 0 1.15rem;
      padding: 0;
      overflow: clip;
      border: 1px solid var(--knox-line);
      border-radius: 12px;
      background:
        linear-gradient(90deg, rgba(45, 212, 191, 0.05), transparent 28%),
        var(--knox-panel);
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    }

    .knox-changelog .changelog-date--latest {
      border-color: rgba(45, 212, 191, 0.42);
    }

    .knox-changelog .changelog-date > summary {
      display: grid;
      grid-template-columns: minmax(8.5rem, auto) minmax(0, 1fr) auto;
      gap: 1.1rem;
      align-items: center;
      min-height: 4.7rem;
      padding: 1rem 1.2rem;
      margin: 0;
      cursor: pointer;
      list-style: none;
      color: #f8fafc;
      background: rgba(255, 255, 255, 0.018);
      transition: background 160ms ease, border-color 160ms ease;
    }

    .knox-changelog .changelog-date > summary::-webkit-details-marker {
      display: none;
    }

    .knox-changelog .changelog-date > summary:hover {
      background: rgba(45, 212, 191, 0.055);
    }

    .knox-changelog .changelog-date[open] > summary {
      margin: 0;
      color: #f8fafc;
      border-bottom: 1px solid rgba(71, 85, 105, 0.42);
      background: rgba(45, 212, 191, 0.045);
    }

    .knox-changelog .changelog-date__date {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      border: 1px solid rgba(45, 212, 191, 0.32);
      border-radius: 999px;
      background: rgba(13, 148, 136, 0.1);
      padding: 0.36rem 0.68rem;
      color: #8ff5e7;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.045em;
      font-variant-numeric: tabular-nums;
    }

    .knox-changelog .changelog-date__title {
      min-width: 0;
      font-size: 1.05rem;
      font-weight: 750;
      letter-spacing: -0.01em;
    }

    .knox-changelog .changelog-date__hint {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #8793a2;
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .knox-changelog .changelog-date__hint::after {
      content: '›';
      display: inline-block;
      color: var(--knox-accent);
      font-size: 1.3rem;
      line-height: 1;
      transform: rotate(90deg);
      transition: transform 160ms ease;
    }

    .knox-changelog .changelog-date[open] > summary .changelog-date__hint::after {
      transform: rotate(-90deg);
    }

    .knox-changelog .changelog-date[open] > summary .changelog-date__hint {
      color: #b8c2ce;
    }

    .knox-changelog .changelog-date__body {
      padding: 1.1rem 1.2rem 1.3rem;
    }

    .knox-changelog .changelog-date__body > :first-child {
      margin-top: 0;
    }

    .knox-changelog .changelog-date__body > :last-child {
      margin-bottom: 0;
    }

    .knox-changelog .changelog-date__body > p {
      max-width: 78ch;
      color: #c2cad3;
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) {
      margin: 0.75rem 0;
      padding: 0;
      overflow: hidden;
      border: 1px solid rgba(71, 85, 105, 0.54);
      border-radius: 9px;
      background: var(--knox-panel-soft);
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) > summary {
      min-height: 3.35rem;
      display: flex;
      align-items: center;
      padding: 0.8rem 1rem;
      margin: 0;
      color: #e8edf3;
      font-size: 0.92rem;
      font-weight: 700;
      list-style: none;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.018);
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) > summary::-webkit-details-marker {
      display: none;
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) > summary::before {
      content: '+';
      display: inline-grid;
      place-items: center;
      width: 1.35rem;
      height: 1.35rem;
      margin-right: 0.7rem;
      border-radius: 5px;
      background: rgba(45, 212, 191, 0.09);
      color: var(--knox-accent);
      font-size: 1rem;
      font-weight: 500;
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date)[open] > summary::before {
      content: '−';
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date)[open] > summary {
      margin: 0;
      color: #8ff5e7;
      border-bottom: 1px solid rgba(71, 85, 105, 0.42);
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) > :not(summary) {
      margin-left: 1rem;
      margin-right: 1rem;
    }

    .knox-changelog .changelog-date__body > details:not(.changelog-date) > ul,
    .knox-changelog .changelog-date__body > details:not(.changelog-date) > ol {
      padding-left: 1.25rem;
    }

    .knox-changelog .changelog-date__body li {
      padding: 0.35rem 0;
    }

    .knox-changelog .changelog-date__body li > p {
      margin: 0;
    }

    .knox-changelog .changelog-date__body img {
      width: 72px;
      max-height: 72px;
      object-fit: cover;
      display: inline-block;
      vertical-align: middle;
      margin: 0 0.75rem 0.25rem 0;
      border: 1px solid rgba(71, 85, 105, 0.55);
      border-radius: 8px;
      background: #0b0b0b;
    }

    @media (min-width: 1024px) {
      .knox-changelog .changelog-date__body {
        padding: 1.35rem 1.5rem 1.55rem;
      }

      .knox-changelog .changelog-date__body > details:not(.changelog-date) {
        max-width: 76rem;
      }
    }

    @media (max-width: 720px) {
      .knox-changelog .changelog-date > summary {
        grid-template-columns: 1fr auto;
        gap: 0.45rem 0.8rem;
        padding: 0.9rem 1rem;
      }

      .knox-changelog .changelog-date__date,
      .knox-changelog .changelog-date__title {
        grid-column: 1;
      }

      .knox-changelog .changelog-date__hint {
        grid-column: 2;
        grid-row: 1 / span 2;
        align-self: center;
      }

      .knox-changelog .changelog-date__body {
        padding: 0.9rem;
      }

      .knox-changelog .changelog-date__hint {
        font-size: 0;
      }

      .knox-changelog .changelog-date__hint::after {
        font-size: 1.35rem;
      }
    }
  </style>
</Layout>
