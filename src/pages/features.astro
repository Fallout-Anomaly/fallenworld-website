---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/fallenworld-home.json';

const categories = ['All', ...new Set(homeData.features.map((feature) => feature.category))];
---

<Layout
  title="Fallen World Features"
  description="Gameplay systems included in Fallen World for Fallout 4."
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <header>
      <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Fallen World</div>
      <h1 class="mt-2 text-4xl font-extrabold uppercase tracking-tight text-white sm:text-5xl">Features</h1>
    </header>

    <section class="mt-10 border-y border-gray-800 py-6" aria-label="Feature filters">
      <input
        id="feature-search"
        type="search"
        placeholder="Search features"
        autocomplete="off"
        aria-label="Search features"
        class="w-full rounded-md border border-gray-700 bg-[#111] px-4 py-3 text-base text-gray-100 outline-none placeholder:text-gray-600 focus:border-emerald-600"
      />

      <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        {categories.map((category, index) => (
          <button
            type="button"
            class={`feature-filter rounded-md border px-3 py-2 text-sm font-medium ${index === 0 ? 'border-emerald-600 text-emerald-300' : 'border-gray-700 text-gray-400 hover:text-gray-200'}`}
            data-category={category}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category}
          </button>
        ))}
      </div>
    </section>

    <div class="mt-6 flex items-center justify-between gap-4">
      <p id="feature-count" class="text-sm text-gray-500">{homeData.features.length} features</p>
      <a href="/roadmap" class="text-sm font-semibold text-emerald-400 hover:text-emerald-300">Roadmap</a>
    </div>

    <div id="feature-list" class="mt-4 divide-y divide-gray-800 border-y border-gray-800">
      {homeData.features.map((feature) => (
        <a
          href={feature.href}
          class="feature-item grid gap-2 py-5 sm:grid-cols-[170px_220px_1fr] sm:gap-6"
          data-category={feature.category}
          data-search={`${feature.title} ${feature.category} ${feature.description}`.toLowerCase()}
        >
          <span class="text-xs font-semibold uppercase tracking-widest text-gray-500">{feature.category}</span>
          <span class="font-semibold text-gray-100">{feature.title}</span>
          <span class="text-sm leading-6 text-gray-400">{feature.description}</span>
        </a>
      ))}
    </div>

    <p id="feature-empty" class="mt-8 hidden text-sm text-gray-500">No matching features.</p>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('feature-search');
  const filterButtons = [...document.querySelectorAll('.feature-filter')];
  const items = [...document.querySelectorAll('.feature-item')];
  const count = document.getElementById('feature-count');
  const empty = document.getElementById('feature-empty');
  let activeCategory = 'All';

  function renderFeatures() {
    const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
    let visible = 0;

    for (const item of items) {
      const category = item.getAttribute('data-category') || '';
      const search = item.getAttribute('data-search') || '';
      const show = (activeCategory === 'All' || category === activeCategory) && (!query || search.includes(query));
      item.classList.toggle('hidden', !show);
      if (show) visible += 1;
    }

    if (count) count.textContent = `${visible} ${visible === 1 ? 'feature' : 'features'}`;
    empty?.classList.toggle('hidden', visible !== 0);
  }

  searchInput?.addEventListener('input', renderFeatures);

  for (const button of filterButtons) {
    button.addEventListener('click', () => {
      activeCategory = button.getAttribute('data-category') || 'All';
      for (const other of filterButtons) {
        const active = other === button;
        other.setAttribute('aria-pressed', active ? 'true' : 'false');
        other.classList.toggle('border-emerald-600', active);
        other.classList.toggle('text-emerald-300', active);
        other.classList.toggle('border-gray-700', !active);
        other.classList.toggle('text-gray-400', !active);
      }
      renderFeatures();
    });
  }
</script>
