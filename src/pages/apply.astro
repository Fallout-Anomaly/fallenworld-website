---
import Layout from '../layouts/Layout.astro';

const discordUrl = 'https://discord.gg/Q5DmJDZFVR';
---

<Layout
  title="Apply"
  description="Join the Fallen World community on Discord to apply as a contributor, tester, artist, writer, or modder."
>
  <div class="mx-auto max-w-2xl px-6 py-20 text-center">
    <div class="mb-3 text-xs font-semibold uppercase tracking-widest text-emerald-500">Community</div>
    <h1 class="mb-4 text-4xl font-extrabold uppercase tracking-tight text-white">Apply to the Team</h1>
    <p class="mb-10 text-lg text-gray-400">
      Want to help build Fallen World? Contributor applications and coordination are handled through our Discord server.
    </p>
    <a
      href={discordUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-md bg-[#5865F2] px-8 py-3 font-semibold text-white transition-colors hover:bg-[#4752c4]"
    >
      Join the Discord
    </a>
    <p class="mt-6 text-sm text-gray-400">Join the server and follow the current contributor application instructions.</p>
  </div>
</Layout>
