---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { articleSlug, statusLabel } from '../../../data/wiki';

const mods = (await getCollection('wiki'))
  .filter((entry) => entry.data.category === 'mods')
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const searchText = (entry: (typeof mods)[number]) => `${entry.data.title} ${entry.data.description} ${entry.data.tags.join(' ')} ${entry.data.type} ${entry.data.status}`
  .replace(/\s+/g, ' ')
  .toLowerCase();
---

<Layout title="Mod Catalog" description="Searchable documentation for mods included in or developed for Fallen World.">
  <div class="mx-auto max-w-[1680px] px-4 py-10 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs text-gray-500">
      <a href="/wiki" class="hover:text-emerald-400">Wiki</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-300">Mods</span>
    </nav>

    <div class="max-w-4xl">
      <div class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-400">Included Mods</div>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white">Mod Catalog</h1>
      <p class="mt-3 text-base leading-7 text-gray-400">Find what a mod changes, why Fallen World uses it, player-facing behavior, compatibility notes, performance impact, known issues, and developer details.</p>
    </div>

    <div class="mt-7 max-w-4xl rounded-lg border border-white/10 bg-[#111] p-3">
      <label for="mod-search" class="sr-only">Search mods</label>
      <input id="mod-search" type="search" placeholder="Search PrismaUI, radiation, crafting, interface..." class="w-full rounded-md border border-white/10 bg-black/30 px-4 py-3 text-sm text-white placeholder:text-gray-500 focus:border-emerald-500/50 focus:outline-none" autocomplete="off" />
      <p id="mod-count" aria-live="polite" class="mt-2 px-1 text-xs text-gray-500">{mods.length} documented mod{mods.length === 1 ? '' : 's'}</p>
    </div>

    <div id="mod-results" class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
      {mods.map((entry) => (
        <a
          href={`/wiki/${articleSlug(entry.id)}`}
          class="mod-card rounded-lg border border-white/10 bg-[#111] p-5 transition-colors hover:border-emerald-500/40 hover:bg-[#141414]"
          data-search={searchText(entry)}
        >
          <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider">
            <span class={entry.data.type === 'official' ? 'text-emerald-400' : 'text-sky-400'}>{entry.data.type}</span>
            <span class="text-gray-600">/</span>
            <span class="text-gray-500">{statusLabel(entry.data.status)}</span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-white">{entry.data.title}</h2>
          <p class="mt-2 text-sm leading-6 text-gray-500">{entry.data.description}</p>
        </a>
      ))}
    </div>

    <div id="mod-empty" class="mt-7 hidden rounded-lg border border-dashed border-white/15 p-8 text-center text-sm text-gray-500">No documented mods match that search.</div>

    <div class="mt-10 flex flex-wrap gap-3 border-t border-white/10 pt-6 text-sm">
      <a href="/wiki/contribute" class="rounded-md border border-white/15 bg-white/5 px-4 py-2 font-semibold text-gray-200 hover:border-emerald-500/40">Contribute Documentation</a>
      <a href="/wiki?category=mods" class="rounded-md border border-white/15 px-4 py-2 font-semibold text-gray-400 hover:text-gray-200">View Mods in Main Search</a>
    </div>
  </div>

  <script>
    const input = document.querySelector('#mod-search');
    const cards = [...document.querySelectorAll('.mod-card')];
    const count = document.querySelector('#mod-count');
    const empty = document.querySelector('#mod-empty');

    function filterMods() {
      const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const show = !query || (card.dataset.search ?? '').includes(query);
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      if (count) count.textContent = `${visible} documented mod${visible === 1 ? '' : 's'}`;
      empty?.classList.toggle('hidden', visible !== 0);
    }

    input?.addEventListener('input', filterMods);
    filterMods();
  </script>
</Layout>
