---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { articleSlug, statusLabel, wikiRepositoryUrl } from '../../../data/wiki';

const guides = (await getCollection('wiki'))
  .filter((entry) => entry.data.category === 'troubleshooting')
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const searchText = (entry: (typeof guides)[number]) => `${entry.data.title} ${entry.data.description} ${entry.data.tags.join(' ')} ${entry.data.status} ${entry.body ?? ''}`
  .replace(/<[^>]+>/g, ' ')
  .replace(/\s+/g, ' ')
  .toLowerCase();
---

<Layout title="Troubleshooting" description="Search Fallen World troubleshooting guides by exact symptom, error, crash behavior, or broken feature.">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs text-gray-500">
      <a href="/wiki" class="hover:text-emerald-400">Wiki</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-300">Troubleshooting</span>
    </nav>

    <div class="max-w-3xl">
      <div class="text-xs font-bold uppercase tracking-[0.18em] text-amber-400">Fix the symptom, not the guess</div>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white">Troubleshooting</h1>
      <p class="mt-3 text-base leading-7 text-gray-400">Search the exact behavior you see: CTD, black screen, menu not opening, repeated freeze, load failure, input issue, missing HUD, or other symptoms.</p>
    </div>

    <div class="mt-7 max-w-3xl rounded-lg border border-white/10 bg-[#111] p-3">
      <label for="troubleshooting-search" class="sr-only">Search troubleshooting</label>
      <input id="troubleshooting-search" type="search" placeholder="Try: repeated freeze, black screen, CTD, loading..." class="w-full rounded-md border border-white/10 bg-black/30 px-4 py-3 text-sm text-white placeholder:text-gray-500 focus:border-amber-500/50 focus:outline-none" autocomplete="off" />
      <p id="troubleshooting-count" aria-live="polite" class="mt-2 px-1 text-xs text-gray-500">{guides.length} troubleshooting guide{guides.length === 1 ? '' : 's'}</p>
    </div>

    <div id="troubleshooting-results" class="mt-7 grid gap-4 md:grid-cols-2">
      {guides.map((entry) => (
        <a
          href={`/wiki/${articleSlug(entry.id)}`}
          class="troubleshooting-card rounded-lg border border-white/10 bg-[#111] p-5 transition hover:border-amber-500/40 hover:bg-[#141414]"
          data-search={searchText(entry)}
        >
          <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-wider">
            <span class="text-amber-400">Troubleshooting</span>
            <span class="text-gray-600">/</span>
            <span class="text-gray-500">{statusLabel(entry.data.status)}</span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-white">{entry.data.title}</h2>
          <p class="mt-2 text-sm leading-6 text-gray-500">{entry.data.description}</p>
          <div class="mt-4 flex items-center justify-between gap-3 text-xs text-gray-600">
            <span>{entry.data.tags.slice(0, 4).join(' · ')}</span>
            <span>{entry.data.fallenWorldVersion}</span>
          </div>
        </a>
      ))}
    </div>

    <div id="troubleshooting-empty" class="mt-7 hidden rounded-lg border border-dashed border-amber-500/20 bg-amber-500/5 p-8 text-center text-sm text-gray-400">
      <p>No troubleshooting page matches that symptom yet.</p>
      <a href={`${wikiRepositoryUrl}/issues/new?template=wiki-report.yml&title=${encodeURIComponent('Wiki: Missing troubleshooting guide')}`} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-semibold text-amber-300 hover:text-amber-200">Report missing documentation</a>
    </div>

    <div class="mt-10 flex flex-wrap gap-3 border-t border-white/10 pt-6 text-sm">
      <a href="/wiki/performance/performance-basics" class="rounded-md border border-white/15 bg-white/5 px-4 py-2 font-semibold text-gray-200 hover:border-emerald-500/40">Performance Basics</a>
      <a href="/wiki/contribute" class="rounded-md border border-white/15 px-4 py-2 font-semibold text-gray-400 hover:text-gray-200">Contribute a Fix</a>
    </div>
  </div>

  <script>
    const input = document.querySelector('#troubleshooting-search');
    const cards = [...document.querySelectorAll('.troubleshooting-card')];
    const count = document.querySelector('#troubleshooting-count');
    const empty = document.querySelector('#troubleshooting-empty');

    function filterTroubleshooting() {
      const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const show = !query || (card.dataset.search ?? '').includes(query);
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      if (count) count.textContent = `${visible} troubleshooting guide${visible === 1 ? '' : 's'}`;
      empty?.classList.toggle('hidden', visible !== 0);
    }

    input?.addEventListener('input', filterTroubleshooting);
    filterTroubleshooting();
  </script>
</Layout>
