---

<Layout
  title="Fallen World: Knox Aftermath | Project Zomboid Server"
  description="Fallen World: Knox Aftermath is a hardcore Project Zomboid survival server with scarce resources, dangerous zombies, PvP, and no second chances."
>
  <section class="knox-hero">
    <div class="knox-steam-bg" aria-hidden="true">
      <img id="knox-bg-a" class="knox-bg-media knox-bg-active" src={steamScreenshots[0]} alt="" />
      <img id="knox-bg-b" class="knox-bg-media" src="" alt="" />
      <video id="knox-bg-video" class="knox-bg-media" muted playsinline preload="metadata" poster={steamMovies[0]?.thumbnail ?? steamScreenshots[0]}></video>
      <div class="knox-bg-scrim"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-6 py-20 sm:py-24">
      <div class="max-w-3xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-widest text-emerald-400">Project Zomboid Server</div>
        <h1 class="text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-lg sm:text-5xl">Fallen World: Knox Aftermath</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-200 drop-shadow-md">
          Hardcore survival RPG with scarce resources, dangerous zombies, PvP, and no second chances.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-14">
    <div class="overflow-hidden rounded-md border border-gray-700 bg-[#111]">
      <img
        src={serverImage}
        alt="Fallen World: Knox Aftermath Project Zomboid server"
        class="block h-auto w-full"
        loading="eager"
        referrerpolicy="no-referrer"
      />
    </div>

    <p class="mt-2 text-right text-xs text-gray-600">
      Background media sourced from the official Project Zomboid Steam store page.
    </p>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="mb-7 text-xs font-semibold uppercase tracking-widest text-emerald-500">Server</div>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4">
        {serverDetails.map(({ label, value }) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">{label}</dt>
            <dd class="mt-1 text-base font-semibold text-gray-100">{value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 border-l-4 border-teal-600 bg-[#111] px-5 py-5">
        <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Connect</div>
        <div class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <code class="text-base font-semibold text-gray-100">157.250.203.86:25593</code>
          <span class="text-sm text-gray-400">No password required</span>
        </div>
        <p class="mt-4 text-sm leading-6 text-gray-300">
          Join &gt; Public Servers &gt; Search for <strong class="text-white">Fallen World: Knox Aftermath</strong>
        </p>
      </div>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="mb-7 text-xs font-semibold uppercase tracking-widest text-emerald-500">Ruleset</div>
      <div class="grid gap-10 lg:grid-cols-3">
        <article>
