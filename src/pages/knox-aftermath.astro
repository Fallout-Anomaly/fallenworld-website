---
import Layout from '../layouts/Layout.astro';

const serverDetails = [
  { label: 'Map', value: 'Muldraugh, KY' },
  { label: 'Build', value: '42.20' },
  { label: 'Players', value: '32' },
  { label: 'Password', value: 'None' },
  { label: 'PvP', value: 'Enabled' },
  { label: 'Voice Chat', value: 'Proximity + 3D Audio' },
];

const zombieRules = [
  'High population',
  'Fast Shamblers',
  'Superhuman strength / Tough',
  'No zombie respawn',
  'Migration enabled',
  'Peak population: Day 28',
  'Sprinters gradually appear over time',
];

const lootRules = [
  'No loot respawn',
  'Reduced food, ammo, medicine, tools & materials',
  'Increased ranged weapon spawns',
  'Once an area is picked clean, it stays that way',
];

const survivalRules = [
  '90-minute days',
  'Water & power: 14-30 days',
  'Blood + saliva infection',
  'Limited gas',
  'Multi-hit disabled',
  'Fire spread enabled',
  'Bandit NPCs enabled',
];
---

<Layout
  title="Fallen World: Knox Aftermath | Project Zomboid Server"
  description="Fallen World: Knox Aftermath is a hardcore Project Zomboid survival server with scarce resources, dangerous zombies, PvP, and no second chances."
>
  <section class="relative overflow-hidden border-b border-white/10 bg-[#090909] px-6 py-20 sm:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(180,83,9,0.16),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(13,148,136,0.12),transparent_40%)]"></div>
    <div class="relative mx-auto max-w-6xl">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-500/25 bg-amber-500/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-amber-300">
        Project Zomboid Server
      </div>
      <h1 class="max-w-4xl text-4xl font-extrabold uppercase tracking-[0.08em] text-white sm:text-5xl lg:text-6xl">
        Fallen World: Knox Aftermath
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-300 sm:text-xl">
        Hardcore Project Zomboid survival with scarce resources, dangerous zombies, PvP, and no second chances.
      </p>
      <p class="mt-6 max-w-3xl text-sm font-semibold uppercase tracking-[0.12em] text-amber-300">
        Build. Scavenge. Trade. Fight. Make what you find count.
      </p>
    </div>
  </section>

  <section class="bg-[#0a0a0a] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-400">Server</p>
        <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-[0.08em] text-white">Knox County Ruleset</h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {serverDetails.map(({ label, value }) => (
          <div class="rounded-lg border border-white/10 bg-[#111] p-5">
            <div class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">{label}</div>
            <div class="mt-2 text-lg font-bold text-gray-100">{value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#0d0d0d] px-6 py-16">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
      <article class="rounded-xl border border-red-500/20 bg-red-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-400">Zombies</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">The Dead Get Worse</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {zombieRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-xl border border-amber-500/20 bg-amber-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Loot</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Nothing Comes Back</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {lootRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-300"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-xl border border-teal-500/20 bg-teal-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-300">Survival</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Every Choice Costs</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {survivalRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-300"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="bg-[#0a0a0a] px-6 py-20">
    <div class="mx-auto max-w-4xl rounded-xl border border-white/10 bg-[#111] p-8 text-center sm:p-12">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Hardcore Survival RPG</p>
      <h2 class="mt-3 text-3xl font-extrabold uppercase tracking-[0.08em] text-white sm:text-4xl">No Reset Button</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-gray-300">
        Build, scavenge, trade, fight, and make what you find count. The world does not replenish itself, and the infected only become more dangerous as the outbreak continues.
      </p>
      <a
        href="https://discord.gg/Q5DmJDZFVR"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-md bg-[#5865F2] px-5 py-3 text-sm font-bold uppercase tracking-[0.08em] text-white transition-colors hover:bg-[#4752c4]"
      >
        Join the Fallen World Discord
      </a>
    </div>
  </section>

  <footer class="border-t border-white/10 bg-[#080808] px-6 py-8 text-center">
    <p class="text-xs leading-6 text-gray-500">
      Fallen World: Knox Aftermath is an unofficial community server. Project Zomboid is developed by The Indie Stone.
    </p>
  </footer>
</Layout>
