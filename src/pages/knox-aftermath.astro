];

const fallbackSteamMovies = [
  {
    name: 'Build 42 Zomboid Trailer',
    url: 'https://video.akamai.steamstatic.com/store_trailers/108600/619982392/141cfd121ea068a87c023951bdbfee87ca524de1/1785320937/hls_264_master.m3u8',
    thumbnail: 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257387571/7413640d5700fc7020002682b958233c04463d0e/movie_600x337.jpg',
  },
  {
    name: 'Build 42 Map Trailer',
    url: 'https://video.akamai.steamstatic.com/store_trailers/108600/1068764969/0b5bcb57cecb7b05c21f23de1ea92a8287c343e7/1785321988/hls_264_master.m3u8',
