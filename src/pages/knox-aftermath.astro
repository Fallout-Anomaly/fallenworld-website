          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {zombieRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
        <article>
          <h2 class="text-xl font-bold text-white">Loot</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {lootRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
        <article>
          <h2 class="text-xl font-bold text-white">Survival</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {survivalRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-teal-600 pl-4 text-sm leading-6 text-gray-400">
        Hardcore survival RPG. Build, scavenge, trade, fight, and make what you find count.
      </p>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Workshop</div>
          <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-tight text-white">Mod List</h2>
        </div>
        <div class="text-sm text-gray-500">{modCount} mods</div>
      </div>

      <div class="mt-8 border-b border-gray-800">
        {modCategories.map((category) => (
          <details class="border-t border-gray-800 py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left">
              <span class="font-semibold text-gray-100">{category.name}</span>
              <span class="text-sm text-gray-500">{category.mods.length}</span>
            </summary>
            <ul class="grid gap-x-8 gap-y-1 pb-5 sm:grid-cols-2">
              {category.mods.map(([name, id]) => (
                <li>
                  <a
                    href={workshop(id)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block py-1.5 text-sm text-gray-400 transition-colors hover:text-emerald-400"
                  >
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10 text-center">
      <a
        href="https://discord.gg/Q5DmJDZFVR"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-md bg-[#5865F2] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#4752c4]"
      >
        Join on Discord
      </a>
    </section>
  </div>

  <footer class="border-t border-gray-800 px-6 py-8 text-center">
    <p class="text-xs leading-6 text-gray-500">
      Fallen World: Knox Aftermath is an unofficial community server. Project Zomboid is developed by The Indie Stone.
    </p>
  </footer>
</Layout>

<script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js"></script>
<script define:vars={{ steamScreenshots, steamMovies }}>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const imageA = document.getElementById('knox-bg-a');
  const imageB = document.getElementById('knox-bg-b');
  const video = document.getElementById('knox-bg-video');

  let activeImage = imageA;
  let inactiveImage = imageB;
  let hls = null;

  const IMAGE_HOLD_MS = 8000;
  const VIDEO_MAX_MS = 45000;

  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  function stopVideo() {
    if (hls) {
      hls.destroy();
      hls = null;
    }

    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.classList.remove('knox-bg-active');
    }
  }

  async function showImage(src) {
    if (!activeImage || !inactiveImage || !src) return;

    stopVideo();
    inactiveImage.src = src;

    try {
      await inactiveImage.decode();
    } catch {}

    inactiveImage.classList.add('knox-bg-active');
    activeImage.classList.remove('knox-bg-active');

    const previous = activeImage;
    activeImage = inactiveImage;
    inactiveImage = previous;

    await sleep(IMAGE_HOLD_MS);
  }

  async function showVideo(movie) {
    if (!video || reduceMotion || !movie?.url) return false;

    return new Promise((resolve) => {
      let finished = false;
      let timeoutId;

      const finish = () => {
        if (finished) return;
        finished = true;
        window.clearTimeout(timeoutId);
        video.removeEventListener('ended', finish);
        video.removeEventListener('error', finish);
        stopVideo();
        resolve(true);
      };

      video.poster = movie.thumbnail || '';
      video.muted = true;
      video.playsInline = true;
      video.addEventListener('ended', finish, { once: true });
      video.addEventListener('error', finish, { once: true });

      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = movie.url;
      } else if (window.Hls && window.Hls.isSupported()) {
        hls = new window.Hls({ enableWorker: true });
        hls.loadSource(movie.url);
        hls.attachMedia(video);
      } else {
        finish();
        return;
      }

      const play = () => {
        video.play().then(() => {
          video.classList.add('knox-bg-active');
          activeImage?.classList.remove('knox-bg-active');
          inactiveImage?.classList.remove('knox-bg-active');
          timeoutId = window.setTimeout(finish, VIDEO_MAX_MS);
        }).catch(finish);
      };

      if (video.readyState >= 2) {
        play();
      } else {
        video.addEventListener('canplay', play, { once: true });
      }
    });
  }

  async function runMediaRotation() {
    if (!imageA || !imageB || steamScreenshots.length === 0) return;

    if (reduceMotion) {
      imageA.src = steamScreenshots[0];
      imageA.classList.add('knox-bg-active');
      return;
    }

    let screenshotIndex = 1;
    let movieIndex = 0;
    let imagesSinceVideo = 0;

    await sleep(IMAGE_HOLD_MS);

    while (true) {
      if (imagesSinceVideo >= 3 && steamMovies.length > 0) {
        await showVideo(steamMovies[movieIndex % steamMovies.length]);
        movieIndex += 1;
        imagesSinceVideo = 0;
        await showImage(steamScreenshots[screenshotIndex % steamScreenshots.length]);
        screenshotIndex += 1;
        imagesSinceVideo += 1;
        continue;
      }

      await showImage(steamScreenshots[screenshotIndex % steamScreenshots.length]);
      screenshotIndex += 1;
      imagesSinceVideo += 1;
    }
  }

  runMediaRotation();
</script>

<style>
  .knox-hero {
    position: relative;
    min-height: min(72vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid #1f2937;
    background: #0a0a0a;
  }

  .knox-steam-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0a0a0a;
  }

  .knox-bg-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 1.8s ease;
  }

  .knox-bg-active {
    opacity: 1;
  }

  .knox-bg-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.62);
  }

  @media (max-width: 640px) {
    .knox-hero {
      min-height: 560px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knox-bg-media {
      transition: none;
      transform: none;
    }
  }
</style>
