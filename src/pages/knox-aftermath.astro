---

<Layout
  title="Fallen World: Knox Aftermath | Project Zomboid Server"
  description="Fallen World: Knox Aftermath is a hardcore Project Zomboid survival server with scarce resources, dangerous zombies, PvP, and no second chances."
>
  <section class="relative overflow-hidden border-b border-white/10 bg-[#090909] px-6 py-14 sm:py-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(180,83,9,0.16),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(13,148,136,0.12),transparent_40%)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-500/25 bg-amber-500/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-amber-300">
          Project Zomboid Server
        </div>
        <h1 class="max-w-4xl text-4xl font-extrabold uppercase tracking-[0.08em] text-white sm:text-5xl lg:text-6xl">
          Fallen World: Knox Aftermath
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-300 sm:text-xl">
          Hardcore survival RPG Project Zomboid server with scarce resources, dangerous zombies, PvP, and no second chances.
        </p>
        <p class="mt-6 max-w-3xl text-sm font-semibold uppercase tracking-[0.12em] text-amber-300">
          Build. Scavenge. Trade. Fight. Make what you find count.
        </p>
      </div>

      <div class="overflow-hidden rounded-xl border border-white/10 bg-black/40 shadow-2xl shadow-black/40">
        <img
          src={serverImage}
          alt="Fallen World: Knox Aftermath Project Zomboid server"
          class="aspect-video h-full w-full object-cover"
          loading="eager"
          referrerpolicy="no-referrer"
        />
      </div>
    </div>
  </section>

  <section class="bg-[#0a0a0a] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-400">Server</p>
        <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-[0.08em] text-white">Knox County Ruleset</h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {serverDetails.map(({ label, value }) => (
          <div class="rounded-lg border border-white/10 bg-[#111] p-5">
            <div class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">{label}</div>
            <div class="mt-2 text-lg font-bold text-gray-100">{value}</div>
          </div>
        ))}
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="rounded-xl border border-teal-500/20 bg-teal-950/10 p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-300">Direct Connection</p>
          <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Server Address</h2>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-lg border border-white/10 bg-black/30 p-4">
              <div class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">IP</div>
              <code class="mt-2 block break-all text-lg font-bold text-teal-300">157.250.203.86</code>
            </div>
            <div class="rounded-lg border border-white/10 bg-black/30 p-4">
              <div class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Port</div>
              <code class="mt-2 block text-lg font-bold text-teal-300">25593</code>
            </div>
          </div>
          <p class="mt-4 text-sm text-gray-400">No password required. The server is public and Steam secure.</p>
        </div>

        <div class="rounded-xl border border-amber-500/20 bg-amber-950/10 p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">In-Game Browser</p>
          <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Find the Server</h2>
          <p class="mt-5 text-sm leading-6 text-gray-300">Open Project Zomboid and use:</p>
          <div class="mt-3 rounded-lg border border-white/10 bg-black/30 p-4 font-mono text-sm leading-7 text-amber-200">
            Join &gt; Public Servers &gt; Search for:<br />
            <strong class="text-white">Fallen World: Knox Aftermath</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#0d0d0d] px-6 py-16">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
      <article class="rounded-xl border border-red-500/20 bg-red-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-400">Zombies</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">The Dead Get Worse</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {zombieRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-xl border border-amber-500/20 bg-amber-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Loot</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Nothing Comes Back</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {lootRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-300"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-xl border border-teal-500/20 bg-teal-950/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-300">Survival</p>
        <h2 class="mt-2 text-2xl font-extrabold uppercase tracking-[0.08em] text-white">Every Choice Costs</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
          {survivalRules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-300"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="bg-[#0a0a0a] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-400">Workshop Collection</p>
          <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-[0.08em] text-white">Current Mod List</h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-gray-400">
            Knox Aftermath currently runs {modCount} mods. Open any category below to view the active Workshop entries.
          </p>
        </div>
        <div class="rounded-full border border-white/10 bg-[#111] px-4 py-2 text-sm font-bold text-gray-300">
          {modCount} mods
        </div>
      </div>

      <div class="grid gap-3 lg:grid-cols-2">
        {modCategories.map((category) => (
          <details class="group rounded-xl border border-white/10 bg-[#111] open:border-teal-500/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left">
              <span class="font-bold text-gray-100">{category.name}</span>
              <span class="rounded-full border border-white/10 bg-black/25 px-2.5 py-1 text-xs font-bold text-gray-400">
                {category.mods.length}
              </span>
            </summary>
            <div class="border-t border-white/10 px-5 py-4">
              <ul class="space-y-2">
                {category.mods.map(([name, url]) => (
                  <li>
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-start justify-between gap-4 rounded-md px-2 py-2 text-sm text-gray-300 transition-colors hover:bg-white/5 hover:text-teal-300"
                    >
                      <span>{name}</span>
                      <span aria-hidden="true" class="shrink-0 text-gray-600">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 bg-[#0d0d0d] px-6 py-20">
    <div class="mx-auto max-w-4xl rounded-xl border border-white/10 bg-[#111] p-8 text-center sm:p-12">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Hardcore Survival RPG</p>
      <h2 class="mt-3 text-3xl font-extrabold uppercase tracking-[0.08em] text-white sm:text-4xl">No Reset Button</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-gray-300">
        Build, scavenge, trade, fight, and make what you find count. The world does not replenish itself, and the infected only become more dangerous as the outbreak continues.
      </p>
      <a
        href="https://discord.gg/Q5DmJDZFVR"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-md bg-[#5865F2] px-5 py-3 text-sm font-bold uppercase tracking-[0.08em] text-white transition-colors hover:bg-[#4752c4]"
      >
        Join the Fallen World Discord
      </a>
    </div>
  </section>

  <footer class="border-t border-white/10 bg-[#080808] px-6 py-8 text-center">
    <p class="text-xs leading-6 text-gray-500">
      Fallen World: Knox Aftermath is an unofficial community server. Project Zomboid is developed by The Indie Stone.
    </p>
  </footer>
</Layout>
