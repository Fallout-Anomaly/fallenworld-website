---

<Layout
  title="Fallen World: Knox Aftermath | Project Zomboid Server"
  description="Fallen World: Knox Aftermath is a hardcore Project Zomboid survival server with scarce resources, dangerous zombies, PvP, and no second chances."
>
  <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16">
    <header class="max-w-3xl">
      <div class="mb-3 text-xs font-semibold uppercase tracking-widest text-emerald-500">Project Zomboid Server</div>
      <h1 class="text-4xl font-extrabold uppercase tracking-tight text-white sm:text-5xl">Fallen World: Knox Aftermath</h1>
      <p class="mt-4 text-lg leading-8 text-gray-400">
        Hardcore survival RPG with scarce resources, dangerous zombies, PvP, and no second chances.
      </p>
    </header>

    <div class="mt-10 overflow-hidden rounded-md border border-gray-700 bg-[#111]">
      <img
        src={serverImage}
        alt="Fallen World: Knox Aftermath Project Zomboid server"
        class="block h-auto w-full"
        loading="eager"
        referrerpolicy="no-referrer"
      />
    </div>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="mb-7 text-xs font-semibold uppercase tracking-widest text-emerald-500">Server</div>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4">
        {serverDetails.map(({ label, value }) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">{label}</dt>
            <dd class="mt-1 text-base font-semibold text-gray-100">{value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 border-l-4 border-teal-600 bg-[#111] px-5 py-5">
        <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Connect</div>
        <div class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <code class="text-base font-semibold text-gray-100">157.250.203.86:25593</code>
          <span class="text-sm text-gray-400">No password required</span>
        </div>
        <p class="mt-4 text-sm leading-6 text-gray-300">
          Join &gt; Public Servers &gt; Search for <strong class="text-white">Fallen World: Knox Aftermath</strong>
        </p>
      </div>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="mb-7 text-xs font-semibold uppercase tracking-widest text-emerald-500">Ruleset</div>
      <div class="grid gap-10 lg:grid-cols-3">
        <article>
          <h2 class="text-xl font-bold text-white">Zombies</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {zombieRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
        <article>
          <h2 class="text-xl font-bold text-white">Loot</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {lootRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
        <article>
          <h2 class="text-xl font-bold text-white">Survival</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-gray-400">
            {survivalRules.map((rule) => <li>• {rule}</li>)}
          </ul>
        </article>
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-teal-600 pl-4 text-sm leading-6 text-gray-400">
        Hardcore survival RPG. Build, scavenge, trade, fight, and make what you find count.
      </p>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-500">Workshop</div>
          <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-tight text-white">Mod List</h2>
        </div>
        <div class="text-sm text-gray-500">{modCount} mods</div>
      </div>

      <div class="mt-8 border-b border-gray-800">
        {modCategories.map((category) => (
          <details class="border-t border-gray-800 py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left">
              <span class="font-semibold text-gray-100">{category.name}</span>
              <span class="text-sm text-gray-500">{category.mods.length}</span>
            </summary>
            <ul class="grid gap-x-8 gap-y-1 pb-5 sm:grid-cols-2">
              {category.mods.map(([name, id]) => (
                <li>
                  <a
                    href={workshop(id)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block py-1.5 text-sm text-gray-400 transition-colors hover:text-emerald-400"
                  >
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12 border-t border-gray-800 pt-10 text-center">
      <a
        href="https://discord.gg/Q5DmJDZFVR"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-md bg-[#5865F2] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#4752c4]"
      >
        Join on Discord
      </a>
    </section>
  </div>

  <footer class="border-t border-gray-800 px-6 py-8 text-center">
    <p class="text-xs leading-6 text-gray-500">
      Fallen World: Knox Aftermath is an unofficial community server. Project Zomboid is developed by The Indie Stone.
    </p>
  </footer>
</Layout>
