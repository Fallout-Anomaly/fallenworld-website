  },
];

let steamScreenshots = fallbackSteamScreenshots;
let steamMovies = fallbackSteamMovies;

try {
  const response = await fetch(steamApiUrl);
  if (response.ok) {
    const payload = await response.json() as Record<string, any>;
    const steamData = payload[String(steamAppId)]?.data;

    const apiScreenshots = Array.isArray(steamData?.screenshots)
      ? steamData.screenshots
          .map((screenshot: any) => screenshot?.path_full)
          .filter((url: unknown): url is string => typeof url === 'string' && url.length > 0)
      : [];

    const apiMovies = Array.isArray(steamData?.movies)
      ? steamData.movies
          .map((movie: any) => ({
            name: movie?.name,
            url: movie?.hls_h264,
            thumbnail: movie?.thumbnail,
          }))
          .filter((movie: any) => typeof movie.url === 'string' && movie.url.length > 0)
      : [];

    if (apiScreenshots.length > 0) steamScreenshots = apiScreenshots.slice(0, 8);
    if (apiMovies.length > 0) steamMovies = apiMovies.slice(0, 2);
  }
} catch {
  steamScreenshots = fallbackSteamScreenshots;
  steamMovies = fallbackSteamMovies;
}

